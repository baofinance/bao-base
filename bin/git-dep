#!/usr/bin/env python3
"""git dep: the cookbook's procedures for a repository's dependencies, with the checks the cookbook asks for.

A repository's dependencies are git submodules, each checked out at every depth. The cookbook,
doc/dependencies.md, gives the git commands for each task. A command here makes the checks the cookbook asks
a reader to make, then runs the cookbook's git commands. It prints each command that changes something
before it runs it, as it would be typed in the repository's top folder.

Its commands are for what concerns the dependencies as such: the settings, the folders at every depth, and
adding, upgrading and removing a dependency. Work inside a dependency (a branch, a merge, a push) is ordinary
git typed in its folder, and has no command here.

It acts on the repository it is typed in. git finds it through an alias, `alias.dep`, which `setup` writes
into the repository's own config. Before that it is run by its path, which is what `yarn setup` does. No
command makes a commit, and none pushes the repository it is typed in.

It ends with status 0 when done, 1 when a check stopped it, 2 for a command or an argument it does not know,
and with git's own status when a git command failed.

It uses the standard library only and runs on Python 3.9 and later: on the python3 of whoever types it.
"""

from __future__ import annotations

import argparse
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path
from typing import NamedTuple

COOKBOOK = Path(__file__).resolve().parent.parent / "doc" / "dependencies.md"

# The settings every clone holds, in the repository and in each dependency folder: the cookbook's "Settings".
SETTINGS = (("push.recurseSubmodules", "check"), ("diff.submodule", "log"), ("status.submoduleSummary", "true"))
# Where a repository holds this script, from its top folder: bao-base itself, and a repository that uses it.
# git runs a shell alias in the top folder of the repository it is typed in, so the alias names one of these.
COPIES = ("bin/git-dep", "lib/bao-base/bin/git-dep")
# What `git submodule foreach` runs in each dependency folder: the settings, and the alias where the folder
# holds a copy of this script.
IN_EACH_FOLDER = "; ".join(
    [
        *(f"git config {key} {value}" for key, value in SETTINGS),
        f'if [ -e {COPIES[0]} ]; then git config alias.dep "!{COPIES[0]}"; '
        f'elif [ -e {COPIES[1]} ]; then git config alias.dep "!{COPIES[1]}"; fi',
    ]
)


class Stopped(Exception):
    """A check found something that stops the command. Its lines say what was found, each with the command
    that mends it."""

    def __init__(self, lines: list[str]):
        super().__init__("\n".join(lines))


class Misused(Exception):
    """What was typed after the command names nothing the command can act on. Its line says what was typed."""


class CommandFailed(Exception):
    """A command that was run failed. It has shown its own message; `status` is its status."""

    def __init__(self, status: int):
        super().__init__(f"a command ended with status {status}")
        self.status = status


class Folder(NamedTuple):
    """One dependency folder, at any depth."""

    path: str  # from the top folder
    parent: str  # the folder whose repository records it, from the top folder: "" for the repository itself
    name: str  # what the parent's .gitmodules calls it
    inside: str  # its path from the parent
    recorded: str  # the commit the parent records for it


class Repository:
    """The repository a command is typed in, and git run in its top folder.

    git gives a script it starts through an alias inside a dependency folder that dependency's GIT_DIR. A git
    command for a folder beneath would then read the dependency's repository, so every git command here runs
    without it."""

    def __init__(self, top: Path):
        self.top = top
        self.environment = {name: value for name, value in os.environ.items() if name != "GIT_DIR"}
        # A command that only reads takes no optional lock, so that not even git's index is written again.
        self.reading = {**self.environment, "GIT_OPTIONAL_LOCKS": "0"}

    def read(self, *arguments: str) -> subprocess.CompletedProcess:
        """A git command that only reads, run in the top folder. It is not printed."""
        return subprocess.run(["git", *arguments], cwd=self.top, capture_output=True, text=True, env=self.reading)

    def ask(self, *arguments: str) -> str:
        """What a reading git command prints, or nothing where git has no answer."""
        return self.read(*arguments).stdout.strip()

    def ask_or_stop(self, *arguments: str) -> str:
        """What a reading git command prints. A failure ends the command here, with git's message and status:
        for a read whose answer decides what is deleted."""
        found = self.read(*arguments)
        if found.returncode != 0:
            sys.stderr.write(found.stderr)
            raise CommandFailed(found.returncode)
        return found.stdout.strip()

    def run(self, *arguments: str, program: str = "git") -> None:
        """A command that changes something: printed as it is typed in the top folder, then run. It shows its
        own output. A failure ends the command here, with its status."""
        typed = [program, *arguments]
        print("$ " + " ".join(shlex.quote(argument) for argument in typed), flush=True)
        status = subprocess.run(typed, cwd=self.top, env=self.environment).returncode
        if status != 0:
            raise CommandFailed(status)

    def checked_out(self, path: str) -> bool:
        return (self.top / path / ".git").exists()

    def branch(self, path: str) -> str | None:
        """The branch the folder is on, or None when it is on none."""
        found = self.read("-C", path, "symbolic-ref", "--quiet", "--short", "HEAD")
        return found.stdout.strip() if found.returncode == 0 else None

    def on_no_branch_or_remote(self, path: str) -> bool:
        """Whether the folder's commit is on no branch and on no remote: an update that moves the folder leaves
        such a commit reachable from git's reflog alone."""
        return bool(self.ask("-C", path, "rev-list", "-n", "1", "HEAD", "--not", "--branches", "--remotes"))

    def listed(self, parent: str) -> list[Folder]:
        """The dependency folders the repository at `parent` lists in its .gitmodules, in the order of their
        paths. A repository with no .gitmodules lists none.

        git ignores an entry whose name is empty or has `..` in it: the repository it would keep under such a
        name is outside the folder it keeps dependencies in. Such an entry is no dependency here either."""
        at = ["-C", parent] if parent else []
        entries = self.read(*at, "config", "--file", ".gitmodules", "--get-regexp", r"^submodule\..*\.path$")
        found = []
        for line in entries.stdout.splitlines():
            key, _, inside = line.partition(" ")
            name = key[len("submodule.") : -len(".path")]
            if not name or ".." in re.split(r"[/\\]", name):
                continue
            staged = self.ask(*at, "ls-files", "--stage", "--", inside).split()
            found.append(
                Folder(
                    path=f"{parent}/{inside}" if parent else inside,
                    parent=parent,
                    name=name,
                    inside=inside,
                    recorded=staged[1] if len(staged) > 1 else "",
                )
            )
        return sorted(found, key=lambda folder: folder.path)

    def folders(self, parent: str = "") -> list[Folder]:
        """Every dependency folder at every depth, each before the folders beneath it."""
        found = []
        for folder in self.listed(parent):
            found.append(folder)
            if self.checked_out(folder.path):
                found.extend(self.folders(folder.path))
        return found


def top_folder() -> Path:
    """The top folder of the repository the command is typed in. Where there is none, git's own message is
    shown and the command ends with git's status."""
    found = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if found.returncode != 0:
        sys.stderr.write(found.stderr)
        raise CommandFailed(found.returncode)
    return Path(found.stdout.strip())


def status(repository: Repository) -> int:
    """Name each dependency folder that is not as recorded, is on a branch, or holds work that only this
    computer has, and count the folders. It reads only: nothing is changed and nothing is fetched."""
    folders = repository.folders()
    named = set()
    for folder in folders:
        found = []
        if not repository.checked_out(folder.path):
            found.append("not checked out")
        else:
            at = ("-C", folder.path)
            branch = repository.branch(folder.path)
            have = repository.ask(*at, "rev-parse", "HEAD")
            only_here = int(repository.ask(*at, "rev-list", "--count", "HEAD", "--branches", "--not", "--remotes"))
            if branch is not None:
                found.append(f"on branch {branch}")
            if have != folder.recorded:
                recorder = folder.parent or "this repository"
                found.append(f"at {have[:10]}, and {recorder} records {folder.recorded[:10]}")
            if branch is None and repository.on_no_branch_or_remote(folder.path):
                found.append(
                    "its commit is on no branch and on no remote. "
                    f"To put it on a branch: git -C {folder.path} switch -c <branch>"
                )
            if only_here:
                found.append(f"{only_here} commit{'' if only_here == 1 else 's'} that no remote has")
            if repository.ask(*at, "status", "--porcelain", "--ignore-submodules=all"):
                found.append("uncommitted changes")
        for line in found:
            named.add(folder.path)
            print(f"{folder.path}: {line}")
    if not folders:
        print("no dependency folders")
    else:
        counted = f"{len(folders)} dependency folder{'' if len(folders) == 1 else 's'}"
        print(f"{counted}: {f'{len(named)} named above' if named else 'nothing to report'}")
    return 0


def refuse_submodule_recurse(repository: Repository, folders: list[Folder]) -> None:
    """Stop where anything git reads sets `submodule.recurse`. With `true`, a branch switch discards an unstaged
    edit beneath a dependency folder. With `false`, git can stop making the push check.

    A config that git keeps for the clone, the repository's or a folder's, is named from the top folder, as its
    command is typed there. git names it from the folder it reads, and in a dependency's folder by its absolute
    path. The person's own config and the system's are named as git names them."""
    lines = []
    seen = set()
    for path in ["", *(folder.path for folder in folders if repository.checked_out(folder.path))]:
        at = ["-C", path] if path else []
        entries = repository.ask(
            *at, "config", "--show-scope", "--show-origin", "--get-regexp", r"^submodule\.recurse$"
        )
        for entry in entries.splitlines():
            scope, origin, setting = entry.split("\t", 2)
            value = setting.partition(" ")[2]
            if not origin.startswith("file:"):
                where, mend = origin.rstrip(":"), "Take it out there"
            else:
                file = origin[len("file:") :]
                if scope in ("local", "worktree"):
                    file = os.path.relpath(repository.top / path / file, repository.top)
                where, mend = file, f"To take it out: git config --file {file} --unset submodule.recurse"
            if where not in seen:
                seen.add(where)
                lines.append(f"submodule.recurse is set to {value} in {where}. {mend}")
    if lines:
        raise Stopped(lines)


def refuse_a_commit_that_would_be_left_behind(repository: Repository, folders: list[Folder]) -> None:
    """Stop where a folder that is on no branch is at a commit that no branch and no remote has. git's update
    moves a folder whatever it holds, and would leave that commit reachable from git's reflog alone."""
    lines = []
    for folder in folders:
        path = folder.path
        if not repository.checked_out(path) or repository.branch(path) is not None:
            continue
        if repository.on_no_branch_or_remote(path):
            have = repository.ask("-C", path, "rev-parse", "HEAD")
            lines.append(
                f"{path}: its commit {have[:10]} is on no branch and on no remote. "
                f"To put it on a branch: git -C {path} switch -c <branch>"
            )
    if lines:
        raise Stopped(lines)


def holds_a_branch(repository: Repository, path: str) -> bool:
    """Whether some folder beneath `path`, at any depth, is on a branch."""
    for folder in repository.listed(path):
        if repository.checked_out(folder.path) and (
            repository.branch(folder.path) is not None or holds_a_branch(repository, folder.path)
        ):
            return True
    return False


def move(repository: Repository, parent: str = "") -> None:
    """Put every folder beneath `parent` that is on no branch at the commit its parent records, at every depth,
    and leave a folder that is on a branch where it is, naming it.

    Where no folder is on a branch, that is git's one recursive command. Where one is, git's command would put
    it back at the recorded commit, on no branch. So the command is run for the other folders by name, and for
    each level on the way down to the folder that is left. The folders beneath a folder that is on a branch are
    still put at the commits that folder records."""
    listed = repository.listed(parent)
    if not listed:
        return
    at = ["-C", parent] if parent else []
    left = [f for f in listed if repository.checked_out(f.path) and repository.branch(f.path) is not None]
    above_one = [f for f in listed if f not in left and holds_a_branch(repository, f.path)]
    if not left and not above_one:
        repository.run(*at, "submodule", "update", "--init", "--recursive")
        return
    others = [f.inside for f in listed if f not in left and f not in above_one]
    if others:
        repository.run(*at, "submodule", "update", "--init", "--recursive", "--", *others)
    for folder in above_one:
        repository.run(*at, "submodule", "update", "--init", "--", folder.inside)
        move(repository, folder.path)
    for folder in left:
        print(f"{folder.path}: left on its branch {repository.branch(folder.path)}", flush=True)
        move(repository, folder.path)


def write_the_settings(repository: Repository) -> None:
    """Write the cookbook's settings and the alias, in the repository and in every dependency folder at every
    depth. A folder that was checked out for the first time holds none of them until this runs."""
    for key, value in SETTINGS:
        repository.run("config", key, value)
    for copy in COPIES:
        if (repository.top / copy).exists():
            repository.run("config", "alias.dep", f"!{copy}")
            break
    repository.run("submodule", "foreach", "--quiet", "--recursive", IN_EACH_FOLDER)


def name_what_is_not_checked_out(repository: Repository, beneath: str = "") -> int:
    """Name each folder beneath `beneath` that is still not checked out. git skips a folder whose update
    setting is none, in a line that is easy to miss, so that setting is named. The cookbook's section for a
    clone that `yarn dep` managed is then named once: its one command takes every such setting out, also from
    the config of a repository whose own folder was skipped, which a command for each folder named here
    would not reach."""
    lines = []
    skipped = False
    for folder in repository.folders(beneath):
        if repository.checked_out(folder.path):
            continue
        at = ["-C", folder.parent] if folder.parent else []
        line = f"{folder.path}: not checked out."
        if repository.ask(*at, "config", "--get", f"submodule.{folder.name}.update") == "none":
            skipped = True
            line += " git skips it, because its update setting is none."
        lines.append(line)
    if skipped:
        lines.append(
            'To take every such setting out, see "A clone that `yarn dep` managed" in the cookbook: git dep cookbook'
        )
    if lines:
        raise Stopped(lines)
    return 0


def setup(repository: Repository) -> int:
    """Write the settings and the alias, in the repository and in every dependency folder. It is what lets git
    run `git dep`. It moves no folder, so it is safe at any time."""
    refuse_submodule_recurse(repository, repository.folders())
    write_the_settings(repository)
    return 0


def update(repository: Repository) -> int:
    """Put every dependency folder at the commit recorded for it, at every depth, then write the settings: the
    cookbook's procedure for after a pull, a merge or a branch switch, which is git's `git submodule update`
    with the checks that keep work. It puts back a folder that was moved on purpose and not staged."""
    folders = repository.folders()
    refuse_submodule_recurse(repository, folders)
    refuse_a_commit_that_would_be_left_behind(repository, folders)
    move(repository)
    write_the_settings(repository)
    return name_what_is_not_checked_out(repository)


def the_dependency(repository: Repository, typed_name: str) -> Folder:
    """The dependency of this repository that a name typed after a command means. A dependency is named by its
    folder, with or without `lib/` in front."""
    wanted = typed_name.rstrip("/")
    listed = repository.listed("")
    for path in (wanted, f"lib/{wanted}"):
        for folder in listed:
            if folder.path == path:
                return folder
    named = f"They are: {', '.join(folder.path for folder in listed)}" if listed else "It has none"
    raise Misused(f"git dep: {typed_name} is not a dependency of this repository. {named}")


def add(repository: Repository, url: str, name: str | None, branch: str | None, tag: str | None) -> int:
    """Add a dependency, check it out at every depth and stage it, then write the settings: the cookbook's
    "Add a dependency". It leaves the remappings and the commit to the person."""
    # Left out, the name is the one git gives a clone: the last part of the url, without `.git`.
    last_of_the_url = re.split(r"[/:]", url.rstrip("/").removesuffix("/.git").removesuffix(".git"))[-1]
    inside = (last_of_the_url if name is None else name).rstrip("/").removeprefix("lib/")
    if not inside:
        raise Misused(f"git dep add: {url} gives no name for the folder. Give one: git dep add <url> <name>")
    path = f"lib/{inside}"
    refuse_submodule_recurse(repository, repository.folders())
    # git finds that the remote lacks a branch only after it has cloned, and it leaves the clone behind. It
    # finds a missing tag after the dependency is staged. So the remote is asked first. git reads a url that
    # starts with ./ or ../ from the repository's own remote, so the remote cannot be asked about that one here.
    if not url.startswith(("./", "../")):
        for kind, called, kept_under in (("branch", branch, "refs/heads"), ("tag", tag, "refs/tags")):
            if called is None:
                continue
            at_the_remote = repository.read("ls-remote", "--exit-code", url, f"{kept_under}/{called}")
            if at_the_remote.returncode == 2:
                raise Stopped([f"{url} has no {kind} {called}"])
            if at_the_remote.returncode != 0:
                sys.stderr.write(at_the_remote.stderr)
                raise CommandFailed(at_the_remote.returncode)
    repository.run("submodule", "add", *(["-b", branch] if branch else []), url, path)
    # git's add leaves the new folder on a branch. A folder from a clone is on none, and `update` leaves a
    # folder that is on a branch where it is. So the new folder is taken off its branch: by the checkout of
    # the tag, or at the commit it is at.
    if tag is None:
        repository.run("-C", path, "switch", "--detach")
    else:
        repository.run("-C", path, "checkout", tag)
    move(repository, path)
    repository.run("add", path)
    write_the_settings(repository)
    print(
        f"{path} is added at {repository.ask('-C', path, 'rev-parse', 'HEAD')[:10]}, and staged. "
        'Left to do: add its remappings, then commit. See "Add a dependency" in the cookbook: git dep cookbook',
        flush=True,
    )
    return name_what_is_not_checked_out(repository, path)


def upgrade(repository: Repository, name: str, version: str | None) -> int:
    """Move a dependency to a version, or with no version to the newest commit of the branch it follows, bring
    the folders beneath it along and stage it, then write the settings: the cookbook's "Upgrade a dependency",
    with the checks that keep work. It leaves the commit to the person."""
    folder = the_dependency(repository, name)
    path = folder.path
    refuse_submodule_recurse(repository, repository.folders())
    # A git command typed for a folder that is not checked out acts on the repository around it.
    if not repository.checked_out(path):
        raise Stopped([f"{path}: not checked out. To check it out: git submodule update --init --recursive -- {path}"])
    if version is None:
        # git alone moves a dependency that follows no branch to the newest commit of its remote's default one.
        if not repository.ask("config", "--file", ".gitmodules", "--get", f"submodule.{folder.name}.branch"):
            raise Stopped(
                [
                    f"{path} follows no branch: .gitmodules has no branch line for it. "
                    f"To move it to a version: git dep upgrade {path} <version>"
                ]
            )
    else:
        # A folder from a clone has a branch of its own, left at the remote's newest commit of that day. Its
        # name typed as the version would move the folder there, and not to the remote's newest commit.
        own = repository.ask("-C", path, "rev-parse", "--verify", "--quiet", f"refs/heads/{version}")
        if own:
            raise Stopped(
                [
                    f"{path} has a branch of its own named {version}, at {own[:10]}. A version is a tag or a "
                    f"commit. For the newest commit of the remote's branch: git dep upgrade {path} origin/{version}"
                ]
            )
    refuse_a_commit_that_would_be_left_behind(repository, [folder, *repository.folders(path)])
    if version is None:
        repository.run("submodule", "update", "--remote", path)
    else:
        repository.run("-C", path, "fetch", "--tags")
        # git answers the checkout of a name it does not have with `--detach does not take a path argument`.
        if not repository.ask("-C", path, "rev-parse", "--verify", "--quiet", f"{version}^{{commit}}"):
            raise Stopped([f"{path} has no tag or commit named {version}, after the fetch from its remote."])
        repository.run("-C", path, "checkout", "--detach", version)
    move(repository, path)
    repository.run("add", path)
    write_the_settings(repository)
    at = repository.ask("-C", path, "rev-parse", "HEAD")[:10]
    if repository.read("diff", "--cached", "--quiet", "--", path).returncode == 0:
        print(f"{path} is at {at}, the commit already recorded. Nothing is left to do.", flush=True)
    else:
        print(f"{path} is at {at}, and staged. Left to do: commit.", flush=True)
    return name_what_is_not_checked_out(repository, path)


def kept_repositories(folder: Path) -> list[Path]:
    """Each repository git keeps at `folder` or beneath it. A dependency's name can hold a `/`, so the
    repository git keeps for it can be several folders down. The ones git keeps for that dependency's own
    dependencies are in its `modules` folder."""
    if (folder / "HEAD").is_file():
        return [folder, *kept_repositories(folder / "modules")]
    if not folder.is_dir():
        return []
    return [kept for inside in sorted(folder.iterdir()) for kept in kept_repositories(inside)]


def work_only_here(repository: Repository, shown: str, at: list[str], has_a_folder: bool) -> list[str]:
    """What one repository holds that only this computer has, a line each with the command that lists it:
    uncommitted changes where it has a folder, commits that no remote has, and stashes. `at` is what a git
    command is typed with to reach it. A read that fails ends the command: no answer is not "nothing"."""
    typed = " ".join(["git", *at])
    lines = []
    if has_a_folder and repository.ask_or_stop(*at, "status", "--porcelain", "--ignore-submodules=all"):
        lines.append(f"{shown}: uncommitted changes. To list: {typed} status --short")
    commits = int(repository.ask_or_stop(*at, "rev-list", "--count", "HEAD", "--branches", "--not", "--remotes"))
    if commits:
        lines.append(
            f"{shown}: {commits} commit{'' if commits == 1 else 's'} that no remote has. "
            f"To list: {typed} log HEAD --branches --not --remotes --oneline"
        )
    stashes = len(repository.ask_or_stop(*at, "stash", "list").splitlines())
    if stashes:
        lines.append(f"{shown}: {stashes} stash{'' if stashes == 1 else 'es'}. To list: {typed} stash list")
    return lines


def remove(repository: Repository, name: str) -> int:
    """Remove a dependency: its folder and its entry in .gitmodules, the repository git keeps for it, and the
    lines git leaves in the settings. That is the cookbook's "Remove a dependency", after its look for work
    that only this computer has. It leaves the remappings and the commit to the person."""
    folder = the_dependency(repository, name)
    path = folder.path
    refuse_submodule_recurse(repository, repository.folders())
    # Named from the top folder, as every command here is typed. In a dependency's folder git gives it absolute.
    kept = os.path.relpath(
        repository.top / repository.ask_or_stop("rev-parse", "--git-path", f"modules/{folder.name}"), repository.top
    )
    # git's own removal does not look at branches or stashes, and deleting the kept repository deletes every
    # one of them. So each repository that goes is looked at first: the folder's and the ones beneath it, and
    # each one git keeps for a folder that is not there.
    found = []
    looked_at = set()
    beneath = repository.folders(path) if repository.checked_out(path) else []
    for there in (path, *(nested.path for nested in beneath)):
        if repository.checked_out(there):
            looked_at.add(Path(repository.ask_or_stop("-C", there, "rev-parse", "--absolute-git-dir")).resolve())
            found.extend(work_only_here(repository, there, ["-C", there], has_a_folder=True))
    for git_keeps in kept_repositories(repository.top / kept):
        if git_keeps.resolve() not in looked_at:
            shown = os.path.relpath(git_keeps, repository.top)
            # git stops at a kept repository that names a folder which is gone, unless it is given another.
            found.extend(
                work_only_here(repository, shown, ["--git-dir", shown, "--work-tree", "."], has_a_folder=False)
            )
    if found:
        raise Stopped([*found, f"{path} is not removed: that work would be deleted with it."])
    repository.run("rm", path)
    if (repository.top / kept).exists():
        repository.run("-rf", kept, program="rm")
    settings = repository.ask_or_stop("config", "--local", "--list", "--name-only").splitlines()
    if any(setting.startswith(f"submodule.{folder.name}.") for setting in settings):
        repository.run("config", "--remove-section", f"submodule.{folder.name}")
    print(
        f"{path} is removed, and the removal is staged. Left to do: take its remappings out, then commit. "
        'See "Remove a dependency" in the cookbook: git dep cookbook',
        flush=True,
    )
    return 0


def typed_as(form: str, does: str) -> argparse.ArgumentParser:
    """What reads the arguments of one command. `form` is the way the command is typed after `git dep`, and
    `does` is the line that says what it does: `help` lists both, and a misuse is answered with the form."""
    return argparse.ArgumentParser(
        prog=f"git dep {form.split()[0]}", usage=f"git dep {form}", description=does, allow_abbrev=False
    )


ADD = typed_as(
    "add <url> [<name>] [--branch <branch> | --tag <tag>]",
    "add a dependency, checked out at every depth, and stage it",
)
ADD.add_argument("url", metavar="<url>", help="the dependency's repository")
ADD.add_argument("name", metavar="<name>", nargs="?", help="its folder in lib/: the end of the url when left out")
ADD_AT = ADD.add_mutually_exclusive_group()
ADD_AT.add_argument("--branch", metavar="<branch>", help="the branch it follows: for a repository of your own")
ADD_AT.add_argument("--tag", metavar="<tag>", help="the release tag it is put at: for a library")

UPGRADE = typed_as(
    "upgrade <name> [<version>]",
    "move a dependency to a version, or to the newest commit of the branch it follows, and stage it",
)
UPGRADE.add_argument("name", metavar="<name>", help="the dependency: its folder, with or without lib/ in front")
UPGRADE.add_argument("version", metavar="<version>", nargs="?", help="a tag or a commit")

REMOVE = typed_as(
    "remove <name>",
    "remove a dependency, after a look for work that only this computer has, and stage the removal",
)
REMOVE.add_argument("name", metavar="<name>", help="the dependency: its folder, with or without lib/ in front")

# Each command that acts on a repository, with what reads its arguments.
ON_A_REPOSITORY = {
    "setup": (
        setup,
        typed_as("setup", "write the settings and the alias, in the repository and in every dependency folder"),
    ),
    "update": (
        update,
        typed_as("update", "put every dependency folder at the commit recorded for it, at every depth"),
    ),
    "status": (
        status,
        typed_as("status", "name each dependency folder that is not as recorded, or holds work only this computer has"),
    ),
    "add": (add, ADD),
    "upgrade": (upgrade, UPGRADE),
    "remove": (remove, REMOVE),
}
# The commands that need no repository.
ELSEWHERE = {
    "cookbook": "print the cookbook: the git commands for each task",
    "help": "list these commands",
}


def help_text() -> str:
    lines = ["git dep <command>", ""]
    for _, reads in ON_A_REPOSITORY.values():
        lines.extend([f"  {reads.usage[len('git dep ') :]}", f"      {reads.description}"])
    for name, does in ELSEWHERE.items():
        lines.extend([f"  {name}", f"      {does}"])
    # Under `git -C`, git starts the script in the folder named, and leaves no sign of where it was typed.
    lines.extend(
        [
            "",
            "It acts on the repository of the folder it is typed in: a clone's top folder, or a dependency's folder.",
            "Each command it prints is for typing in that repository's top folder.",
            "Typed as git -C <folder> dep, that is the top folder of the repository at <folder>, not where it was typed.",
        ]
    )
    return "\n".join(lines) + "\n"


def main(arguments: list[str]) -> int:
    command = arguments[0] if arguments else "help"
    if command in ("help", "-h"):
        sys.stdout.write(help_text())
        return 0
    if command == "cookbook":
        sys.stdout.write(COOKBOOK.read_text())
        return 0
    if command not in ON_A_REPOSITORY:
        known = ", ".join([*ON_A_REPOSITORY, *ELSEWHERE])
        sys.stderr.write(f"git dep: {command} is not one of its commands. They are: {known}\n")
        return 2
    run, reads = ON_A_REPOSITORY[command]
    # Arguments the command does not take end the run here, with the way it is typed and status 2.
    asked = vars(reads.parse_intermixed_args(arguments[1:]))
    try:
        return run(Repository(top_folder()), **asked)
    except Misused as misused:
        sys.stderr.write(f"{misused}\n")
        return 2
    except Stopped as stopped:
        sys.stderr.write(f"{stopped}\n")
        return 1
    except CommandFailed as failed:
        return failed.status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

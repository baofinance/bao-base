#!/usr/bin/env bash
set -euo pipefail
# Usage: verify-audit [revision-or-pattern ...]
# Defaults to `audit*` and `deploy*`. Fails if a deployed contract's creation
# bytecode has drifted since a resolved revision (new files are OK).
#
# An argument holding a glob metacharacter is a PATTERN, expanded via `git tag -l`
# (so `deploy-*` works — quote it to avoid shell globbing); matching no tags is
# information, not a failure. Any other argument is an EXPLICIT name and must
# resolve, or the run fails: a tag, a branch, or a commit SHA — so a repo that cuts
# no tags can still compare against the commit its deploy was built from. A name
# that is both a tag and a branch resolves as the tag, and says so.
#
# A changed file is auto-cleared when it is meaning-neutral: its version at that
# revision and at HEAD compile to the same metadata-stripped creation bytecode. Both
# sides are compiled with the current toolchain (FOUNDRY_BYTECODE_HASH=none,
# FOUNDRY_CBOR_METADATA=false) in a throwaway git worktree, building only the
# changed files and their import closure; a guard fails loudly if those switches
# stop disabling metadata. This clears renames, comment/NatSpec, and formatting
# changes that do not alter bytecode. Rename detection is forced on (git -M -l0)
# so a repo's diff.renames / diff.renameLimit config cannot mis-report a rename
# as drift. Deletions, and any change that alters bytecode, are reported.
# Requires `forge` and `jq` on PATH.
#
# A `.verify-audit-ignore` file in the current directory controls what is
# skipped. Each non-comment, non-blank line has the form:
#
#   rev                          — ignore the whole revision
#   rev file1 file2 ...          — ignore specific files within the revision only;
#                                  other drifting files in it still fail
#   rev {dir1 dir2} [file ...]   — restrict the revision's checks to those
#                                  directories (the deploy only covered them); files
#                                  outside the dirs are not checked, and any file
#                                  entry outside them is an error
#   rev {path.json:field} [file] — scope to the contracts a deployment manifest
#                                  records: the named JSON field's values (read at
#                                  that revision), each taken up to its ":" suffix.
#                                  This is complete by construction. Dirs and
#                                  manifests may be mixed inside { }.
#
# `rev` is the argument as written on the command line — a tag, branch or commit.
# `#` begins a comment. Ignored revisions/files are reported but do not contribute
# to the exit status — unless an entry is stale: a file entry that matches no
# changed file, whose change would now clear (bytecode-equivalent), or that lies
# outside the revision's declared scope. All are reported as errors ("remove it")
# so the ignore file stays minimal.

# Where audited source may live. Rename detection pairs only among the paths that
# survive the pathspec, so any location a source file can legitimately move TO must
# be listed here: otherwise the move looks like an unpaired deletion inside src, and
# git pairs it with whatever unrelated new file scores above its similarity
# threshold — reporting that new file as drift while hiding the real move.
_AUDIT_PATHSPEC=(src deprecated/src)

# Where a deleted file went, if it is still on disk. Git pairs a rename only among
# paths it tracks that survive the pathspec, so a move whose destination is untracked,
# or outside _AUDIT_PATHSPEC, reaches the report as a plain deletion. Matching is by
# exact blob identity, never similarity: an identical blob elsewhere IS the moved file.
# Echoes a note, or nothing when the deletion is genuine.
_locate_moved() { # $1 = revision, $2 = deleted path
  local rev="$1" path="$2" blob base c
  blob=$(git rev-parse "${rev}:${path}" 2>/dev/null) || return 0
  base="${path##*/}"
  while IFS= read -r c; do
    [[ "${c##*/}" == "${base}" && -f "${c}" ]] || continue
    [[ "$(git hash-object "${c}" 2>/dev/null)" == "${blob}" ]] || continue
    if git ls-files --error-unmatch "${c}" >/dev/null 2>&1; then
      printf 'identical content at %s (tracked, outside the audit pathspec - add its directory to _AUDIT_PATHSPEC)' "${c}"
    else
      printf 'identical content at %s (untracked - git add it so the move is seen as a rename)' "${c}"
    fi
    return 0
  done < <(git ls-files --cached --others --exclude-standard)
}

# Confirm the metadata-disabling env switches actually take effect; else fail
# loudly. Guards against a future Foundry renaming/ignoring these switches, which
# would otherwise leave metadata in the bytecode and produce false fails/clears.
_assert_metadata_disabled() {
  local cfg rc
  cfg=$(FOUNDRY_BYTECODE_HASH=none FOUNDRY_CBOR_METADATA=false forge config 2>&1)
  rc=$?
  if [[ ${rc} -ne 0 ]]; then
    printf '\033[31mERROR: `forge config` failed; cannot verify metadata disabled:\n%s\033[0m\n' "${cfg}" >&2
    return 1
  fi
  if ! grep -q 'bytecode_hash = "none"' <<<"${cfg}" ||
    ! grep -q 'cbor_metadata = false' <<<"${cfg}"; then
    printf '\033[31mERROR: metadata not disabled; forge config reports:\n%s\033[0m\n' \
      "$(grep -E 'bytecode_hash|cbor_metadata' <<<"${cfg}")" >&2 # lint-bash disable=command-substitution
    return 1
  fi
}

# Build specific source files of the working tree (HEAD) into $1, metadata off.
# Only the given paths and their import closure are compiled.
_build_head_out() { # $1 = abs out dir, $2.. = src paths
  local out="$1"
  shift
  FOUNDRY_BYTECODE_HASH=none FOUNDRY_CBOR_METADATA=false FOUNDRY_OUT="${out}" forge build --deny=never "$@" >/dev/null
}

# One shared throwaway worktree pinned at HEAD (HEAD's foundry.toml, lib, settings)
# with a persistent forge cache, so the import closure compiles once and is reused
# across every revision. Created lazily on the first revision that needs a build.
_ensure_worktree() {
  [[ -n "${_wt}" ]] && return 0
  _wt=$(mktemp -u)     # git worktree add creates this dir; it must not pre-exist
  _wt_out=$(mktemp -d) # forge out dir, pre-created
  git worktree add --detach --quiet "${_wt}" HEAD || return 1
  git -C "${_wt}" submodule update --init --recursive --quiet || return 1
}

# Overlay the revision's source into the shared HEAD worktree and build the requested
# contracts into the persistent cache. Caller reads signatures from "${_wt_out}",
# then calls _restore_overlay.
_overlay_and_build_revision() { # $1 = revision, then: <overlay paths> -- <build paths>
  local rev="$1"
  shift
  # Args are: <overlay paths> -- <build paths>. The overlay set is the WHOLE
  # changed cascade (so a built contract's renamed dependencies resolve to the
  # files they had at that revision); only the build set is compiled and later compared.
  # `git restore --source` only touches working-tree files — never HEAD.
  local overlay=() build=() _seen=0 a
  for a in "$@"; do
    if [[ "${a}" == "--" ]]; then
      _seen=1
      continue
    fi
    if [[ ${_seen} -eq 0 ]]; then
      overlay+=("${a}")
    else
      build+=("${a}")
    fi
  done
  git -C "${_wt}" restore --source="${rev}" --worktree -- "${overlay[@]}" || return 1
  (cd "${_wt}" && FOUNDRY_BYTECODE_HASH=none FOUNDRY_CBOR_METADATA=false FOUNDRY_OUT="${_wt_out}" forge build --deny=never "${build[@]}" >/dev/null)
}

# Restore overlaid paths back to HEAD so an overlaid dependency cannot leak into a
# later revision's build. A path absent at HEAD (a rename's old path) is removed.
_restore_overlay() { # $@ = paths
  local p
  for p in "$@"; do
    if git cat-file -e "HEAD:${p}" 2>/dev/null; then
      git -C "${_wt}" restore --source=HEAD --worktree -- "${p}"
    else
      rm -f "${_wt}/${p}"
    fi
  done
}

# True when a (HEAD-layout) path is within the current revision's scope: under one
# of the scope directories, or — mapped to its path at that revision via the rename
# map — among its deployed contracts. Uses the per-revision _scope_dirs / _deployed /
# _rename_src set in the main loop.
_in_scope() { # $1 = path
  local p="$1" d
  for d in "${_scope_dirs[@]}"; do
    if [[ "${p}" == "${d}"/* || "${p}" == "${d}" ]]; then
      return 0
    fi
  done
  [[ -v _deployed["${_rename_src[$p]:-$p}"] ]]
}

# Remove the shared worktree and build dirs. Idempotent; run via an EXIT trap so
# it fires on every exit path (`run` sets no EXIT trap of its own, so this is
# safe). `git worktree remove` can fail on a submodule-populated worktree, so
# follow it with rm + prune to guarantee the registration is cleared.
_cleanup_builds() {
  if [[ -n "${_wt}" ]]; then
    git worktree remove --force "${_wt}" 2>/dev/null
    rm -rf "${_wt}"
    git worktree prune 2>/dev/null || true
    _wt=""
  fi
  if [[ -n "${_wt_out}" ]]; then
    rm -rf "${_wt_out}"
    _wt_out=""
  fi
  if [[ -n "${_head_out}" ]]; then
    rm -rf "${_head_out}"
    _head_out=""
  fi
}

# Sorted concat of the creation bytecode of every contract compiled from one .sol
# file. forge writes artifacts to <out>/<basename>.sol/<Contract>.json. Names are
# not used, so this is robust to renames; a multi-contract file compares its whole
# set. "__MISSING__" if the file produced no artifacts (e.g. deleted/uncompiled).
_file_signature() { # $1 = out dir, $2 = sol path
  # split: `local x=$(cmd)` returns local's status, hiding a failing basename
  local dir
  dir="$1/$(basename "$2")"
  [[ -d "${dir}" ]] || {
    printf '__MISSING__'
    return 0
  }
  jq -r '.bytecode.object // ""' "${dir}"/*.json 2>/dev/null | LC_ALL=C sort | tr -d '\n'
}

main() {
  [[ $# -gt 0 ]] || set -- "audit*" "deploy*"
  _head_out=""              # reused HEAD build dir, created lazily on the first revision that builds
  _wt=""                    # shared HEAD worktree (the revision's source overlaid into it), created lazily
  _wt_out=""                # persistent forge cache for the worktree, reused across revisions
  trap _cleanup_builds EXIT # guarantee worktree/build-dir cleanup on every exit path

  # Parse .verify-audit-ignore. Entries are keyed by the revision name as written on
  # the command line. ignores[rev]: space-separated file list (empty = whole-revision
  # ignore). scopes[rev]: space-separated directory pathspecs the revision applies to
  # (default src/); a "rev {dir1 dir2} ..." line declares it, restricting the diff to
  # those dirs and requiring any file entries to live within them.
  declare -A ignores=()
  declare -A scopes=()
  if [[ -f .verify-audit-ignore ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      line="${line%%#*}"
      line="${line#"${line%%[![:space:]]*}"}"
      line="${line%"${line##*[![:space:]]}"}"
      [[ -z "$line" ]] && continue
      read -r rev rest <<<"$line"
      if [[ "${rest}" == "{"* ]]; then # optional scope: rev {dir1 dir2} ...
        scope="${rest#\{}"
        scope="${scope%%\}*}"
        rest="${rest#*\}}"
        rest="${rest#"${rest%%[![:space:]]*}"}" # trim leading space before any files
        read -r -a _s <<<"${scope}"             # normalise internal whitespace
        scopes["$rev"]="${_s[*]}"
      fi
      if [[ -z "${rest:-}" ]]; then
        if [[ -v scopes["$rev"] ]]; then
          : # scope-only declaration; no file ignores
        else
          ignores["$rev"]="" # whole-revision ignore
        fi
      elif [[ -v ignores["$rev"] && -z "${ignores[$rev]}" ]]; then
        : # already whole-revision; file entries don't narrow it
      else
        ignores["$rev"]+="${ignores[$rev]:+ }${rest}" # accumulate file list
      fi
    done <.verify-audit-ignore
  fi

  # Refresh the tags. Whether the local tag list is stale cannot be answered locally — a tag you
  # have never seen leaves no trace — so the only way to audit against the tags that actually exist
  # is to ask the remote. In CI this is redundant (actions/checkout with fetch-depth: 0 has just
  # fetched everything); it is here for a developer whose clone has not seen a recently cut tag,
  # who would otherwise audit fewer tags than exist and be told nothing was wrong.
  git fetch --tags --no-recurse-submodules

  # A shallow repository is refused rather than audited. It holds an unknown subset of the tagged
  # commits — the tag at the cloned tip is there, older ones are not — so the patterns below would
  # match only what happens to be present and the audit would report success having checked a
  # subset it never names. Nothing in the tag list distinguishes that from a genuinely complete run,
  # and the fetch above does not repair it: fetching into a shallow clone keeps it shallow.
  shallow=$(git rev-parse --is-shallow-repository) || {
    echo "ERROR: could not determine whether this is a shallow repository" >&2
    exit 1
  }
  if [[ "${shallow}" == "true" ]]; then
    echo "ERROR: this is a shallow clone, so an unknown subset of tagged commits is absent and the audit cannot be complete" >&2
    echo "       fetch the full history first (in GitHub Actions: actions/checkout with fetch-depth: 0)" >&2
    exit 1
  fi

  # Resolve each argument to the revision it names. An argument containing a glob
  # metacharacter is a PATTERN: it is expanded with `git tag -l`, and matching
  # nothing is a legitimate answer. Anything else is an EXPLICIT name and must
  # resolve, or the run fails — a typo that exits 0 reports everything is fine
  # having compared against nothing, the same silent pass as a repo with no tags.
  #
  # Every name is pinned to a commit SHA here, and only the SHA is used for git
  # operations afterwards. Git does not resolve an ambiguous name consistently:
  # with a tag and a branch both called `x`, `git diff x` takes the tag while
  # `git restore --source=x` takes the branch — so the two sides of the comparison
  # would come from different commits and their difference would silently clear.
  # The tag wins, and the collision is reported so the caller can see which was used.
  fail=0
  revisions=()           # names as given, for output and .verify-audit-ignore lookup
  declare -A _rev_sha=() # name -> the commit it resolved to
  for arg in "$@"; do
    if [[ "${arg}" == *[\*\?\[]* ]]; then
      matches=$(git tag -l "${arg}")
      if [[ -z "${matches}" ]]; then
        echo "INFO: No tags match '${arg}'"
        continue
      fi
      while IFS= read -r t; do
        revisions+=("${t}")
        _rev_sha["${t}"]=$(git rev-parse --verify --quiet "refs/tags/${t}^{commit}")
      done <<<"${matches}"
      continue
    fi
    if sha=$(git rev-parse --verify --quiet "refs/tags/${arg}^{commit}"); then
      if git show-ref --verify --quiet "refs/heads/${arg}"; then
        printf 'NOTE: "%s" is both a tag and a branch; using the tag\n' "${arg}"
      fi
    elif ! sha=$(git rev-parse --verify --quiet "${arg}^{commit}"); then
      printf '\033[31mERROR: "%s" is not a tag, branch or commit in this repository\033[0m\n' "${arg}" >&2
      fail=1
      continue
    fi
    revisions+=("${arg}")
    _rev_sha["${arg}"]="${sha}"
  done

  # Process revisions oldest-first: consecutive overlays then share the most source,
  # so forge's content-addressed cache rebuilds the least between them.
  if [[ ${#revisions[@]} -gt 1 ]]; then
    mapfile -t revisions < <(
      for t in "${revisions[@]}"; do
        printf '%s\t%s\n' "$(git log -1 --format=%ct "${_rev_sha[$t]}")" "${t}"
      done | sort -n | cut -f2
    )
  fi

  for t in "${revisions[@]+"${revisions[@]}"}"; do
    _sha="${_rev_sha[$t]}"
    printf '\n\033[1;36m=== %s ===\033[0m\n' "${t}"

    # Resolve the revision's scope into directories and a deployed-contract set. A
    # scope token of the form path.json:field is a deployment manifest read at that
    # revision:
    # the named JSON field is harvested wherever it occurs and each value is taken
    # up to any ":" (so "src/X.sol:X" and "src/X.sol" both yield "src/X.sol") — the
    # exact deployed contracts at the paths they had there. Other tokens are directories.
    # Default scope is all of src/.
    _scope_dirs=()
    declare -A _deployed=()
    read -r -a _scope_tokens <<<"${scopes[$t]:-src}"
    for tok in "${_scope_tokens[@]}"; do
      if [[ "${tok}" == *.json:* ]]; then
        _mpath="${tok%:*}"
        _mfield="${tok##*:}"
        if ! _manifest=$(git show "${_sha}:${_mpath}" 2>/dev/null); then
          printf '\033[31m  ERROR: scope manifest "%s" not found at revision "%s"\033[0m\n' "${_mpath}" "${t}"
          fail=1
          continue
        fi
        _n=0
        while IFS= read -r cp; do
          [[ -z "${cp}" ]] && continue
          _deployed["${cp%%:*}"]=1
          _n=$((_n + 1))
        done < <(jq -r --arg f "${_mfield}" '[.. | objects | .[$f]? // empty] | .[]' <<<"${_manifest}" 2>/dev/null)
        if [[ ${_n} -eq 0 ]]; then
          printf '\033[31m  ERROR: scope manifest "%s" field "%s" for revision "%s" yielded no paths\033[0m\n' "${_mpath}" "${_mfield}" "${t}"
          fail=1
        fi
      elif [[ "${tok}" == *.json ]]; then
        printf '\033[31m  ERROR: manifest scope "%s" for revision "%s" needs a field, e.g. "%s:contractPath"\033[0m\n' "${tok}" "${t}" "${tok}"
        fail=1
      else
        _scope_dirs+=("${tok}")
      fi
    done

    # Rename map new_path -> old_path, built over all of src so it can pair renames
    # that cross a scope boundary. Maps HEAD paths back to the revision's paths for
    # both the deployed-set scope check (_in_scope) and the bytecode comparison.
    declare -A _rename_src=()
    while IFS=$'\t' read -r _st _old _new; do
      _rename_src["${_new}"]="${_old}"
    done < <(git diff -M -l0 --name-status --diff-filter=R "${_sha}" -- "${_AUDIT_PATHSPEC[@]}")

    # Gather all changed files (-M -l0 forces rename detection regardless of repo
    # diff.renames config), then keep only those within the revision's scope. Both diffs
    # MUST use the same pathspec: they are separate git invocations, and rename
    # detection pairs only among the paths that survive the pathspec, so differing
    # specs would produce disagreeing rename maps.
    # Status is captured from THIS diff, not re-queried per file: a per-file diff has
    # no partner in its pathspec, so rename detection cannot run and a rename would be
    # misreported as a deletion.
    declare -A _status=()
    _changed_all=()
    while IFS=$'\t' read -r _st _p1 _p2; do
      if [[ "${_st}" == R* ]]; then
        _status["${_p2}"]="R"
        _changed_all+=("${_p2}")
      else
        _status["${_p1}"]="${_st:0:1}"
        _changed_all+=("${_p1}")
      fi
    done < <(git diff -M -l0 --name-status --diff-filter=DMRT "${_sha}" -- "${_AUDIT_PATHSPEC[@]}")
    changed=()
    _all_old=() # the revision's path for every changed file — the cascade overlaid so a
    # narrowly-scoped contract's renamed dependencies still resolve when it builds
    for f in "${_changed_all[@]}"; do
      _all_old+=("${_rename_src[${f}]:-${f}}")
      if _in_scope "${f}"; then
        changed+=("${f}")
      fi
    done

    # Scope check + collect in-scope file ignores. A file entry outside the revision's
    # scope can never be checked, so it is an error. Done before the no-changes
    # short-circuit so it is caught even on a clean scope.
    ig_files=()
    if [[ -v ignores["$t"] && -n "${ignores[$t]}" ]]; then
      read -r -a _raw_ig <<<"${ignores[$t]}"
      for ig in "${_raw_ig[@]}"; do
        if _in_scope "${ig}"; then
          ig_files+=("${ig}")
        else
          printf '\033[31m  ERROR: .verify-audit-ignore entry: "%s" for revision "%s" is outside its scope {%s} — remove it\033[0m\n' "${ig}" "${t}" "${scopes[$t]:-src}"
          fail=1
        fi
      done
    fi

    # Whole-revision ignore
    if [[ -v ignores["$t"] && -z "${ignores[$t]}" ]]; then
      if [[ ${#changed[@]} -eq 0 ]]; then
        printf '\033[31m  ERROR: stale .verify-audit-ignore entry: revision "%s" has no changes — remove it\033[0m\n' "${t}"
        fail=1
      fi
      printf '\033[2m(ignored via .verify-audit-ignore)\033[0m\n'
      continue
    fi

    if [[ ${#changed[@]} -eq 0 ]]; then
      printf '\033[32mno changes under src/\033[0m\n'
      continue
    fi

    # File-level ignore: check for stale entries, then filter
    check=()
    ignored_changed=() # ignored files that DID change — verified in Stage 2 to flag
    # any whose change would now clear (a redundant entry to remove)
    if [[ -v ignores["$t"] ]]; then
      # reverse check: flag any ignored file that has no actual drift (ig_files was
      # validated against the revision's scope above)
      for ig in "${ig_files[@]}"; do
        found=0
        for f in "${changed[@]}"; do
          # unquoted deliberately: $ig is a .verify-audit-ignore glob, so it must match as a pattern
          # shellcheck disable=SC2053
          [[ "$f" == $ig ]] && {
            found=1
            break
          }
        done
        if [[ $found -eq 0 ]]; then
          printf '\033[31m  ERROR: stale .verify-audit-ignore entry: "%s" for revision "%s" has no changes — remove it\033[0m\n' "$ig" "${t}"
          fail=1
        fi
      done
      for f in "${changed[@]}"; do
        skip=0
        for ig in "${ig_files[@]}"; do
          # unquoted deliberately: $ig is a .verify-audit-ignore glob, so it must match as a pattern
          # shellcheck disable=SC2053
          [[ "$f" == $ig ]] && {
            skip=1
            break
          }
        done
        if [[ $skip -eq 1 ]]; then
          ignored_changed+=("$f")
        else
          check+=("$f")
        fi
      done
    else
      check=("${changed[@]}")
    fi

    # Stage 2: clear files whose baseline and HEAD versions compile to the same
    # metadata-stripped creation bytecode. Build only the changed files and their
    # import closure, once per revision; reuse one HEAD build across revisions. A file absent
    # at HEAD (a deletion, or a rename git did not pair) cannot be compiled there —
    # it is genuine drift, reported directly without a build. Ignored files that DID
    # change are built in the same pass to flag any that would now clear (a redundant
    # entry); a deletion an entry legitimately suppresses is not built.
    if [[ ${#check[@]} -gt 0 || ${#ignored_changed[@]} -gt 0 ]]; then
      residue=()
      compare=()
      compare_old=()
      compare_ig=() # parallel marker: 1 = ignore entry being verified, 0 = normal check
      for f in "${check[@]}"; do
        if git cat-file -e "HEAD:${f}" 2>/dev/null; then
          compare+=("${f}")
          compare_old+=("${_rename_src[${f}]:-${f}}")
          compare_ig+=(0)
        else
          residue+=("${f}")
        fi
      done
      for f in "${ignored_changed[@]}"; do
        if git cat-file -e "HEAD:${f}" 2>/dev/null; then
          compare+=("${f}")
          compare_old+=("${_rename_src[${f}]:-${f}}")
          compare_ig+=(1)
        else
          printf '\033[2m  %s (ignored via .verify-audit-ignore)\033[0m\n' "${f}"
        fi
      done
      if [[ ${#compare[@]} -gt 0 ]]; then
        if [[ -z "${_head_out}" ]]; then
          _assert_metadata_disabled || exit 1
          _head_out=$(mktemp -d)
        fi
        if ! _build_head_out "${_head_out}" "${compare[@]}"; then
          printf '\033[31m  ERROR: HEAD build failed — cannot compare bytecode\033[0m\n' >&2
          exit 1
        fi
        if ! _ensure_worktree; then
          printf '\033[31m  ERROR: could not set up HEAD worktree — cannot compare bytecode\033[0m\n' >&2
          exit 1
        fi
        if ! _overlay_and_build_revision "${_sha}" "${_all_old[@]}" -- "${compare_old[@]}"; then
          printf '\033[31m  ERROR: build at "%s" failed — cannot compare bytecode\033[0m\n' "${t}" >&2
          exit 1
        fi
        idx=0
        for f in "${compare[@]}"; do
          old_path="${compare_old[${idx}]}"
          ig="${compare_ig[${idx}]}"
          idx=$((idx + 1))
          sig_old=$(_file_signature "${_wt_out}" "${old_path}")
          sig_new=$(_file_signature "${_head_out}" "${f}")
          if [[ "${sig_old}" == "${sig_new}" && "${sig_old}" != "__MISSING__" ]]; then
            if [[ "${ig}" -eq 1 ]]; then
              printf '\033[31m  ERROR: stale .verify-audit-ignore entry: "%s" for revision "%s" would now clear (bytecode-equivalent) — remove it\033[0m\n' "${f}" "${t}"
              fail=1
            else
              printf '\033[2m  %s (cleared: bytecode-equivalent)\033[0m\n' "${f}"
            fi
          else
            if [[ "${ig}" -eq 1 ]]; then
              printf '\033[2m  %s (ignored via .verify-audit-ignore)\033[0m\n' "${f}"
            else
              residue+=("${f}")
            fi
          fi
        done
        _restore_overlay "${_all_old[@]}"
      fi
      check=("${residue[@]+"${residue[@]}"}")
    fi

    if [[ ${#check[@]} -eq 0 ]]; then
      printf '\033[32mno changes under src/ (ignored or cleared)\033[0m\n'
      continue
    fi

    fail=1
    printf '\033[31m  CHANGED (not ignored):\033[0m\n'
    for f in "${check[@]}"; do
      printf '\033[31m    %s\033[0m\n' "$f"
      # A deletion's diff is the whole file as removals: it says nothing beyond the
      # filename and drowns the other entries. Report the fact instead.
      if [[ "${_status[$f]:-}" == "D" ]]; then
        _moved=$(_locate_moved "${_sha}" "${f}")
        if [[ -n "${_moved}" ]]; then
          printf '\033[2m      deleted since the revision; %s\033[0m\n' "${_moved}"
        else
          printf '\033[2m      deleted since the revision (no diff shown)\033[0m\n'
        fi
        continue
      fi
      changes=$(GIT_PAGER="" git diff --minimal --color=always --diff-filter=DMRT "${_sha}" -- "$f")
      linecount=$(printf '%s\n' "${changes}" | wc -l)
      if [[ "${linecount}" -gt 20 ]]; then
        printf '%s\n' "${changes}" | head -n 20
        printf '\033[2m    ... (truncated to 20 lines)\033[0m\n'
      else
        printf '%s\n' "${changes}"
      fi
    done
    printf '\033[31mchanges under src/\033[0m\n'

  done
  exit "${fail}"
}

# bao-base bin scripts are sourced by `run`, so they must run on source. Tests
# source with first arg "BATS" to load the functions without running main.
if [[ "${1:-}" != "BATS" ]]; then
  main "$@"
fi

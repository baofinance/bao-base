#!/usr/bin/env bash
set -e
set -o pipefail

[[ "${BAO_BASE_VERBOSITY:-0}" -gt 0 ]] && set -x
VERBOSITY="-v"
if [[ "${BAO_BASE_VERBOSITY:-0}" -gt 0 ]]; then VERBOSITY="-$(printf "%${BAO_BASE_VERBOSITY}s" "" | tr ' ' 'v')"; fi

mkdir -p results
status=0
# --no-dynamic-test-linking works around a forge defect that makes tests pass against source they
# cannot pass against. Dynamic test linking (on by default since forge 1.8.0) rewrites `new Contract(...)`
# in a test into a deploy performed at run time, so the test file no longer needs recompiling when only
# that contract's body changes - and the build cache stops recompiling it. When the rewrite is not
# applied to a contract the cache skips the recompile anyway, so the test keeps running the creation code
# compiled into it earlier.
# Verified on forge 1.8.1: an edited aggregator reported all tests passing with gas figures identical to
# the digit, against a return statement that could not produce them.
# Reported as https://github.com/foundry-rs/foundry/issues/16682, which forge 1.8.3 fixed for contracts
# in the src directory. A contract outside src - how harbor's tests reach bao-base in lib/ - still loses
# the change on 1.8.3, however it is imported: https://github.com/foundry-rs/foundry/issues/16901.
# Both bodies are kept in bug-reports/. Remove this flag once forge fixes 16901 - not before.
# tests/toolchain/test_forge_dynamic_test_linking.py fails if this flag is removed while the defect stands.
set -x
forge test "${VERBOSITY}" --no-dynamic-test-linking --nmp "script/**/*.t.sol" --summary "$@" || status=$?
{ set +x; } 2>/dev/null
# make forge's exit status the script's return value: the set +x above would otherwise mask it,
# and run sources this script under `|| exit_code=$?` which suppresses set -e
(exit "$status")

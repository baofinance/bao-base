#!/usr/bin/env bash
set -e
set -o pipefail

[[ "${BAO_BASE_VERBOSITY:-0}" -gt 0 ]] && set -x
VERBOSITY="-v"
if [[ "${BAO_BASE_VERBOSITY:-0}" -gt 0 ]]; then VERBOSITY="-$(printf "%${BAO_BASE_VERBOSITY}s" "" | tr ' ' 'v')"; fi

mkdir -p results
status=0
# Needs forge 1.8.4 or later. Older forge, with dynamic test linking on (its default), does not recompile
# a test when only the body of a contract it deploys changes and that contract is outside src - which is
# how harbor's tests reach bao-base in lib/ - so the test runs the creation code compiled into it earlier
# and passes against source that cannot pass. tests/toolchain/test_forge_dynamic_test_linking.py fails on
# such a forge; --no-dynamic-test-linking avoids the defect there.
set -x
forge test "${VERBOSITY}" --nmp "script/**/*.t.sol" --summary "$@" || status=$?
{ set +x; } 2>/dev/null
# make forge's exit status the script's return value: the set +x above would otherwise mask it,
# and run sources this script under `|| exit_code=$?` which suppresses set -e
(exit "$status")

#!/usr/bin/env python3
"""Bring one dependency to a named version, and leave nothing half-done.

This is a CHECKLIST it converges, not a script it runs. Each stage is a question about the state
plus the action that answers it; anything already true is left alone. So it finishes a version bump
someone started in the VSCode GUI, or an update a `forge` run abandoned, as readily as it does one of
its own - and running it twice is safe.

It moves the dependency with GIT and writes foundry.lock itself. `forge install` was measured doing
both, and charging for the lock by DELETING the dependency's working tree whenever it fails -
including when it fails because git refused to overwrite an uncommitted edit, so the refusal is the
destruction. git refuses without touching anything: the edit survives, the submodule does not move,
and untracked and gitignored files are left alone. The safety check below is therefore a second line
of defence with a clearer message, not the only thing standing between the user and lost work.
(`forge install` remains right for installing a dependency that does not exist yet: there is nothing
there to destroy.)

Nothing here writes to the SUPERPROJECT's git. Staging and committing are the user's, so the last two
stages complete by printing the commands rather than running them - and reporting them as done on the
next run once the user has.
"""

from __future__ import annotations

import argparse
import json
import shutil
import subprocess
import sys
from pathlib import Path

from submodule_state import Pin, checklist, read_facts

USAGE = """\
update-submodule [--check] [--force] <dependency>[@<ref>] ...

  <dependency>   a directory under lib/, or a path to a submodule
  @<ref>         the tag, branch or commit to move to. Required when the current pin is a tag or a
                 commit, because those cannot resolve themselves; a branch pin takes its own tip.
  --check        report what is left to do and change nothing
  --force        proceed even though something under the dependency exists nowhere else

At least one dependency must be named. There is deliberately no form meaning "all": that shape lets
one request change dependencies nobody asked about."""


def git(where: Path, *arguments: str) -> subprocess.CompletedProcess[str]:
    return subprocess.run(["git", *arguments], cwd=where, capture_output=True, text=True)


def resolve_path(repo_root: Path, dependency: str) -> str:
    """A dependency is named by its directory under lib/, but a full path is accepted too."""
    for candidate in (dependency, f"lib/{dependency}"):
        if (repo_root / candidate / ".git").exists():
            return candidate
    raise SystemExit(f"error: no submodule at '{dependency}' or 'lib/{dependency}'")


def classify(submodule: Path, ref: str) -> Pin:
    """Which KIND of pin `ref` is, which is what the lock records and what a later bare run needs.

    A tag and a commit are stationary and a branch moves, so this decides whether `yarn update <dep>`
    can ever resolve itself again. Asked of git rather than of the string's shape, because a branch
    and a tag can be named anything.
    """
    tag = git(submodule, "rev-parse", "--verify", "--quiet", f"refs/tags/{ref}^{{commit}}")
    if tag.returncode == 0:
        return Pin("tag", ref, tag.stdout.strip())
    branch = git(submodule, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{ref}^{{commit}}")
    if branch.returncode == 0:
        return Pin("branch", ref, branch.stdout.strip())
    commit = git(submodule, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}")
    if commit.returncode == 0:
        return Pin("rev", None, commit.stdout.strip())
    return Pin("absent", None, None)


def write_lock_entry(repo_root: Path, path: str, pin: Pin) -> None:
    """Rewrite one entry, in the byte-for-byte format forge writes: two-space indent, keys sorted, no
    trailing newline. The rest of the file is carried through untouched rather than regenerated, so a
    field this tool does not understand is not silently dropped."""
    lock_file = repo_root / "foundry.lock"
    raw = json.loads(lock_file.read_text()) if lock_file.is_file() else {}
    raw[path] = {"rev": pin.rev} if pin.kind == "rev" else {pin.kind: {"name": pin.name, "rev": pin.rev}}
    lock_file.write_text(json.dumps(raw, indent=2, sort_keys=True))


def remove_stranded(repo_root: Path, path: str, litter: list[str]) -> list[str]:
    """Delete directories a version change stopped declaring, which git reports it is "unable to
    rmdir" and then leaves behind. Its gitdir goes too, or git reuses it if the path ever returns."""
    removed = []
    for entry in litter:
        directory = repo_root / path / entry
        marker = directory / ".git"
        if marker.is_file():
            pointer = marker.read_text().partition("gitdir:")[2].strip()
            if pointer:
                shutil.rmtree((directory / pointer).resolve(), ignore_errors=True)
        shutil.rmtree(directory, ignore_errors=True)
        removed.append(f"{path}/{entry}")
    return removed


def report(facts, stages, done_actions: list[str]) -> None:
    for line in done_actions:
        print(f"  {line}")
    for stage in stages:
        print(f"  [{'x' if stage.done else ' '}] {stage.number}. {stage.name} - {stage.detail}")
        if not stage.done and stage.action:
            print(f"        {stage.action}")


def converge(repo_root: Path, dependency: str, check_only: bool, force: bool) -> int:
    """Bring one dependency to its ref, doing only what is not already done. Returns 0 on success."""
    requested_ref = None
    if "@" in dependency:
        dependency, _, requested_ref = dependency.partition("@")
    path = resolve_path(repo_root, dependency)
    submodule = repo_root / path
    print(f"{path}:")

    facts = read_facts(repo_root, path)

    # Stage 0, before anything is touched. git would refuse a move over an uncommitted edit anyway,
    # but it cannot see unpushed commits or a nested submodule's own work, and its message names one
    # file rather than the whole picture.
    if facts.has_own_work and not force:
        for item in facts.at_risk:
            print(f"  ! {item.path} ({item.kind}: {item.detail})")
        print("  refusing: the above exists nowhere else.")
        print("  Commit and push what matters, then run this again - or repeat with --force.")
        return 1

    ref = requested_ref or (facts.lock.name if facts.lock.moving else None)
    if ref is None:
        pin = facts.lock
        # Only a branch names something that moves on its own. A tag or a commit is a fixed point, and
        # a dependency with no lock entry names nothing at all - in every case the version wanted is
        # the user's to say, and guessing it would silently pick one.
        if pin.kind in ("tag", "rev"):
            named = pin.name or (pin.rev or "")[:10]
            print(f"  refusing: pinned to the {pin.kind} {named}, which cannot move on its own.")
        else:
            print(f"  refusing: foundry.lock does not pin {path}, so there is no ref to resolve.")
        print(f"  Name the version you want, e.g. `yarn update {Path(path).name}@{facts.worktree_ref or '<ref>'}`")
        return 1

    if not check_only:
        git(submodule, "fetch", "--tags", "--quiet", "origin")

    target = classify(submodule, ref)
    if target.rev is None:
        print(f"  refusing: '{ref}' is not a tag, branch or commit in {path}")
        return 1

    stages = checklist(facts, ref, target.rev)
    if check_only:
        report(facts, stages, [])
        return 0

    performed: list[str] = []
    if facts.worktree != target.rev:
        moved = git(submodule, "checkout", "--quiet", target.rev)
        if moved.returncode != 0:
            print(f"  git refused to move it, and changed nothing:\n{moved.stderr.rstrip()}")
            return 1
        performed.append(f"moved to {ref} ({target.rev[:10]})")

    recursed = git(submodule, "submodule", "update", "--init", "--recursive")
    if recursed.returncode != 0:
        print(f"  could not update nested submodules:\n{recursed.stderr.rstrip()}")
        return 1
    if recursed.stdout.strip():
        performed.append("brought nested submodules to their recorded commits")

    after_move = read_facts(repo_root, path)
    for gone in remove_stranded(repo_root, path, after_move.litter):
        performed.append(f"removed {gone}, stranded by the version change")

    if facts.lock.rev != target.rev or facts.lock.name != target.name or facts.lock.kind != target.kind:
        write_lock_entry(repo_root, path, target)
        performed.append(f"wrote foundry.lock: {target.kind} {target.name or target.rev[:10]}")

    # The post-check is the diagnosis run again, not a second implementation of it: whatever the
    # stages asked for before is what they are asked for now.
    facts = read_facts(repo_root, path)
    stages = checklist(facts, ref, target.rev)
    report(facts, stages, performed)

    # Only the stages this tool performs. 0 and 1 are preconditions decided before acting - and under
    # --force stage 0 stays unticked on purpose, because the thing it warned about is still there.
    # 6 and 7 are the user's, so they are reported rather than required.
    outstanding = [stage for stage in stages if not stage.done and 2 <= stage.number <= 5]
    if outstanding:
        print(f"  FAILED: {len(outstanding)} stage(s) did not complete")
        return 1
    print(f"  Now yours to run:  git add {path} && git commit")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(add_help=False, usage=USAGE)
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("-h", "--help", action="store_true")
    parser.add_argument("dependencies", nargs="*")
    arguments = parser.parse_args()

    if arguments.help:
        print(USAGE)
        return 0
    if not arguments.dependencies:
        print(USAGE, file=sys.stderr)
        print("\nerror: name at least one dependency", file=sys.stderr)
        return 1

    top = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    )
    if top.returncode != 0:
        print("error: not inside a git repository", file=sys.stderr)
        return 1
    repo_root = Path(top.stdout.strip())

    return max(
        converge(repo_root, dependency, arguments.check, arguments.force)
        for dependency in arguments.dependencies
    )


if __name__ == "__main__":
    sys.exit(main())

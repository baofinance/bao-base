#!/usr/bin/env python3
"""Manage this repository's dependencies with git alone, and never touch the index.

A wrapper around git's submodule commands that is forge-aware: it reads forge's remappings, to check out
only what the build reads, and forge's libs folder, where every dependency lives. Its arguments are
written as git writes them.

`.gitmodules` alone says what a bare `update` does. A `branch` line means the dependency follows that
branch; with none it is pinned where it points, and a bare update leaves it there. Nothing follows a
branch .gitmodules does not name - unlike git, whose `update --remote` falls back to whatever the
remote's default branch is at the time.

`sync` brings the checkouts to what this repository records: every top-level submodule at its gitlink,
plus exactly the nested submodules forge's remappings point into. The build reads nothing else. A
dependency's other nested submodules are its own lockfile, wanted only by someone working inside it, so
they are never fetched - and one of them pinned to a commit no remote holds cannot stop this checkout.
A clone made without --recurse-submodules needs nothing more than this.

`add` clones a new dependency into the first of forge's libs folders, under the name its url ends in, as
`forge install` places one, and writes what `git submodule add` writes - except to the index. `-b` and
`--branch` pass through to `git clone --branch`: a branch or tag, which git asks the remote for before it
writes anything. Without them, the remote's default branch, as git takes it. The branch it lands on is
recorded in `.gitmodules` - including the default one, which git does not record - and a tag is pinned.

`update` moves one dependency to a named version, checking out beneath it the same nested paths and no
others. A branch is recorded as the one it follows; a tag or a commit removes the line, pinning it. A bare
update follows the recorded branch, and refuses a pinned dependency. Nothing is fetched or moved until the
pre-checks pass: nothing under the dependency may exist only here, and a local branch it would stand on
may hold no commit the target lacks.

`remove` runs `git submodule deinit`, for a dependency or for a submodule inside one. For a dependency it
then deletes the repository git keeps for it, as gitsubmodules(7) says to, and hands over the `git rm`
that takes out the folder and the `.gitmodules` entry. A submodule inside a dependency is the
dependency's to list and record, so for one of those the checkout is all that goes. sync and update leave
a nested checkout no remapping uses where it is, since its remapping may be on its way, and name the
remove that takes it away.

Every command that changes something is printed as it finishes, in order. A failure prints the tool's
own error beneath the command that failed, then where each checkout now stands, and undoes nothing:
what happened is there to be read and unpicked, and running again once the cause is fixed finishes the
job.

What is staged and committed is the developer's, so nothing here runs a command that changes the index.
"""

from __future__ import annotations

import argparse
import os
import re
import shutil
import subprocess
import sys
from collections.abc import Callable
from pathlib import Path, PurePosixPath
from typing import Any

from forge_config import forge_config
from submodule_state import (
    MOVING,
    Declared,
    Pin,
    at_record,
    at_risk,
    checked_out,
    declared_submodules,
    describe_at_risk,
    git,
    move_checklist,
    nested_levels,
    read_facts,
    recorded_entry,
    remapping_target,
    remote_holds,
    staged_gitlink,
    submodule_levels,
)

USAGE = """\
dep sync
dep status [--no-fetch]
dep add [(-b | --branch) <branch or tag>] <url>
dep update [--force] <dependency>[@<version>] ...
dep remove [--force] <dependency> ...

  sync          Check out each submodule at the commit this repository points to. Inside a submodule,
                check out only the submodules that a remapping uses. Use it after cloning, or after a
                pull changes where this repository points.
  status        For each submodule, and each submodule inside one that a remapping uses: the branch it
                follows, what the commit this repository points to is (a tag, the tip of the branch, or
                a commit), what is newer upstream, whether a remote holds that commit, and what the
                folder has. Fetches first; --no-fetch reads what the last fetch left. Changes nothing
                else.
  add           Clone a new submodule into <first libs folder>/<name>, where <name> is the last part of
                <url> without .git, as git submodule add does: at the branch or tag -b names, or else at
                the remote's default branch. .gitmodules then says which branch it follows; at a tag it
                follows none and is pinned. To depend on a commit, add, then update to the commit.
  update        Move a submodule to <version>: a branch, which .gitmodules then says it follows, or a
                tag or a commit, which pins it there. With no <version>, follow the branch .gitmodules
                names; a pinned submodule is left where it is.
  remove        Take a submodule's checkout away (git submodule deinit). For a submodule of this
                repository, also delete the repository git keeps for it, then hand over the git rm that
                removes it. A submodule inside another one stays listed by the one that contains it.
  <dependency>  its path in the first libs folder, with or without that folder: dep, lib/dep, dep/lib/x
  --force       update: move it even when it holds work that exists only on this computer, or when its
                local branch has commits that the version does not. HEAD is then detached, and the
                branch keeps its commits.
                remove: remove it even when it holds work that exists only on this computer."""


class StepFailed(Exception):
    """A command that changes something exited non-zero. `run` has already printed it and its error."""


def run(repo_root: Path, where: Path, *arguments: str) -> None:
    """Run one git command that changes something, and print it as it finishes. A failure also prints
    everything git said, then raises `StepFailed`, which stops the run where it stands."""
    result = subprocess.run(["git", *arguments], cwd=where, capture_output=True, text=True)
    located = where.relative_to(repo_root).as_posix()
    command = " ".join(["git", *(["-C", located] if located != "." else []), *arguments])
    if result.returncode == 0:
        print(f"  ran: {command}", flush=True)
        return
    print(f"  failed (exit {result.returncode}): {command}", flush=True)
    for line in (result.stdout + result.stderr).rstrip().splitlines():
        print(f"    {line}", flush=True)
    raise StepFailed(command)


def report_unused_checkouts(repo_root: Path, path: str, remappings: list[str]) -> None:
    """Print each submodule checked out beneath `path` that no remapping uses, with the command that removes
    it. It stays where it is: the developer may be about to add its remapping. The walk goes down through
    the submodules a remapping uses, and not into an unused one, since removing it removes what it holds."""
    targets = [PurePosixPath(remapping_target(remapping)) for remapping in remappings]
    for level in declared_submodules(repo_root / path):
        nested = f"{path}/{level.path}"
        if not (repo_root / nested / ".git").exists():
            continue
        if any(target.is_relative_to(nested) for target in targets):
            report_unused_checkouts(repo_root, nested, remappings)
        else:
            print(f"  ! {nested} is checked out, and no remapping uses it. To remove it: yarn dep remove {nested}")


def checkout_rows(repo_root: Path, dependencies: list[Declared], remappings: list[str]) -> dict[str, tuple[Path, Declared]]:
    """Each dependency and each nested path a remapping reaches, by its path from the top, with the folder
    whose .gitmodules lists it: what the build reads."""
    rows: dict[str, tuple[Path, Declared]] = {entry.path: (repo_root, entry) for entry in dependencies}
    for remapping in remappings:
        for directory, level in submodule_levels(repo_root, remapping_target(remapping)):
            rows.setdefault((directory / level.path).relative_to(repo_root).as_posix(), (directory, level))
    return rows


def report(repo_root: Path, dependencies: list[Declared], remappings: list[str], skipped: set[str]) -> bool:
    """Print where each dependency and each nested path a remapping reaches now stands, then each remapping
    no submodule provides, then each nested checkout no remapping uses. Returns whether every dependency and
    nested path is at the commit recorded for it."""
    rows = checkout_rows(repo_root, dependencies, remappings)
    for display, (directory, level) in rows.items():
        have, want = checked_out(directory / level.path), staged_gitlink(directory, level.path)
        parent = "this repository" if directory == repo_root else directory.relative_to(repo_root).as_posix()
        if at_record(directory, level):
            print(f"  [x] {display} - at {(have or '')[:10]}, the commit {parent} points to")
        else:
            print(
                f"  [ ] {display} - the folder has {(have or 'nothing')[:10]},"
                f" {parent} points to {(want or 'nothing')[:10]}"
            )
    for remapping in remappings:
        # Reported, not failed: an unused remapping into nothing builds, and doctor is what grades it. Said
        # only once every level on the way is at its record - before that, the missing path is the
        # unfinished checkout a row above already shows, not something no submodule provides.
        target = remapping_target(remapping)
        levels = list(submodule_levels(repo_root, target))
        if not (repo_root / target).exists() and all(at_record(directory, level) for directory, level in levels):
            print(f"  ! remapping {remapping} points to {target}, which does not exist")
    # Beneath a skipped dependency nothing is read: its checkout is not at the commit this repository points to.
    for entry in dependencies:
        if entry.path not in skipped and (repo_root / entry.path / ".git").exists():
            report_unused_checkouts(repo_root, entry.path, remappings)
    return all(at_record(directory, level) for directory, level in rows.values())


def stop_for_work(heading: str, found: list[str], moving: str, force_command: str | None) -> None:
    """The message that keeps work only this computer has: what was not moved, what the work is, why
    moving matters, and the choices."""
    print(f"  {heading} These exist only on this computer:")
    for line in found:
        print(f"    {line}")
    print(f"  {moving}")
    print("  Push what you want to keep, or remove what you do not, then run this again.")
    if force_command is not None:
        print(f"  To continue anyway: {force_command}")


def read_forge_config(repo_root: Path) -> dict[str, Any] | None:
    """What forge resolves from foundry.toml, or None when forge cannot resolve it - forge's own error printed."""
    try:
        return forge_config(repo_root)
    except subprocess.CalledProcessError as failed:
        print(f"  failed (exit {failed.returncode}): forge config --json")
        for line in failed.stderr.rstrip().splitlines():
            print(f"    {line}")
        return None


def sync(repo_root: Path, remappings: list[str]) -> int:
    print("sync:")
    dependencies = declared_submodules(repo_root)

    # Before anything runs. Moving a checkout is what would put work at risk, so a dependency sync would
    # move must hold nothing that exists only here. One that does is skipped and named, and the others are
    # synced all the same. One already at its record is not moved, so it is not checked.
    skipped: set[str] = set()
    for entry in dependencies:
        if checked_out(repo_root / entry.path) is None or at_record(repo_root, entry):
            continue
        held = [describe_at_risk(item, entry.path) for item in at_risk(repo_root / entry.path)]
        if held:
            skipped.add(entry.path)
            stop_for_work(f"Skipped {entry.path}.", held, "Sync would move the folder that holds them.", None)

    try:
        run(repo_root, repo_root, "submodule", "sync")
        for entry in dependencies:
            if entry.path in skipped:
                continue
            if not at_record(repo_root, entry):
                run(repo_root, repo_root, "submodule", "update", "--init", "--", entry.path)
            # A dependency that follows a branch stands on it only where the branch already holds the
            # recorded commit. A branch anywhere else is the developer's, and moving it is not sync's.
            if entry.branch is not None:
                checkout = repo_root / entry.path
                tip = git(checkout, "rev-parse", "--verify", "--quiet", f"refs/heads/{entry.branch}").stdout.strip()
                standing = git(checkout, "symbolic-ref", "--quiet", "HEAD").stdout.strip()
                if tip == staged_gitlink(repo_root, entry.path) and standing != f"refs/heads/{entry.branch}":
                    run(repo_root, checkout, "checkout", "--quiet", entry.branch)
        for remapping in remappings:
            # Lazy, so each level is checked out before the walk reads the next level's .gitmodules from it.
            # The first level is a dependency, handled above; beneath a skipped one nothing is read, since its
            # checkout is not at the commit this repository points to.
            levels = submodule_levels(repo_root, remapping_target(remapping))
            first = next(levels, None)
            if first is None or first[1].path in skipped:
                continue
            for directory, level in levels:
                if not at_record(directory, level):
                    run(repo_root, directory, "submodule", "update", "--init", "--", level.path)
    except StepFailed:
        report(repo_root, dependencies, remappings, skipped)
        return 1
    return 0 if report(repo_root, dependencies, remappings, skipped) else 1


def status(repo_root: Path, remappings: list[str], fetch: bool) -> int:
    """Print, for each dependency and each nested path a remapping uses, what it follows, what the commit
    this repository points to is, what is newer upstream, whether a remote holds that commit, and what the
    folder has. Fetches first, unless `fetch` is false, which changes what each clone knows of its remote and
    nothing else: no checkout, no branch, no index. Returns 1 when a fetch failed, since what follows it is
    then as of the last fetch."""
    print("status:")
    fetch_failed = False
    for display, (directory, level) in checkout_rows(repo_root, declared_submodules(repo_root), remappings).items():
        checkout = directory / level.path
        pointed = staged_gitlink(directory, level.path)
        print(f"  {display}")
        if pointed is None:
            print(f"    {'points to':<10} nothing: git does not track it yet")
            continue
        have = checked_out(checkout)
        if have is None:
            print(f"    {'points to':<10} {pointed[:10]}")
            print(f"    {'folder':<10} not checked out, so nothing more is known (yarn dep sync checks it out)")
            continue
        if fetch:
            try:
                run(repo_root, checkout, "fetch", "--tags", "--quiet", "--no-recurse-submodules", "origin")
            except StepFailed:
                fetch_failed = True

        known = git(checkout, "cat-file", "-e", f"{pointed}^{{commit}}").returncode == 0
        tags = git(checkout, "tag", "--points-at", pointed).stdout.split() if known else []
        # A branch .gitmodules names is followed; with none the dependency is pinned where it points.
        follows = level.branch
        if follows is not None:
            where = ".gitmodules" if directory == repo_root else f"{directory.relative_to(repo_root).as_posix()}'s .gitmodules"
            print(f"    {'follows':<10} branch {follows}, set in {where}")
        else:
            print(f"    {'follows':<10} nothing: pinned at {f'tag {tags[0]}' if tags else 'a commit'}")

        tip = (
            git(checkout, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{follows}^{{commit}}").stdout.strip()
            if follows is not None
            else ""
        )
        named = [f"tag {tag}" for tag in tags] + ([f"the tip of origin/{follows}"] if tip == pointed else [])
        print(f"    {'points to':<10} {pointed[:10]}, {', '.join(named) or 'a commit'}")

        newer: list[str] = []
        if known and tip and git(checkout, "merge-base", "--is-ancestor", pointed, tip).returncode != 0:
            # A release generated on a branch of its own, as OpenZeppelin's upgradeable ones are: the branch
            # followed never held it, so none of its commits is newer than it.
            newer.append(f"origin/{follows} does not contain it")
        elif known and tip:
            count = int(git(checkout, "rev-list", "--count", f"{pointed}..{tip}").stdout.strip())
            newer.append(f"{count} newer commit{'' if count == 1 else 's'} on origin/{follows}" if count else f"nothing newer on origin/{follows}")
        # Version order, with a pre-release (v1.0.0-rc.1) before its release, among the tags named in the same
        # scheme as this one's: a repository that moved from 1.3.0 to v0.2.1 names nothing newer by it.
        family = "v[0-9]*" if tags and tags[0].startswith("v") else "[0-9]*"
        ranked = git(checkout, "-c", "versionsort.suffix=-", "tag", "--sort=-v:refname", "--list", family).stdout.split()
        newest = ranked[0] if tags and ranked else None
        if newest is not None and newest not in tags:
            newer.append(f"newest tag {newest}")
        elif newest is not None and follows is None:
            newer.append("no newer tag")
        if not newer:
            newer.append(
                "no branch or tag to compare with"
                if follows is None and not tags
                else "unknown: the commit or the branch is not in this clone"
            )
        print(f"    {'upstream':<10} {'; '.join(newer)}")

        held = remote_holds(checkout, pointed)
        print(f"    {'remote':<10} {'unknown' if held is None else 'a remote holds it' if held else 'no remote holds it'}")

        if have == pointed:
            folder = "the commit it points to"
        elif known and git(checkout, "merge-base", "--is-ancestor", pointed, have).returncode == 0:
            count = int(git(checkout, "rev-list", "--count", f"{pointed}..{have}").stdout.strip())
            folder = f"{have[:10]}, {count} commit{'' if count == 1 else 's'} ahead of it"
        elif known and git(checkout, "merge-base", "--is-ancestor", have, pointed).returncode == 0:
            count = int(git(checkout, "rev-list", "--count", f"{have}..{pointed}").stdout.strip())
            folder = f"{have[:10]}, {count} commit{'' if count == 1 else 's'} behind it"
        else:
            folder = f"{have[:10]}, another commit"
        held_here = at_risk(checkout)
        changes = sum(1 for item in held_here if item.kind != "unpushed")
        unpushed = sum(1 for item in held_here if item.kind == "unpushed")
        work = [
            *([f"{changes} change{'' if changes == 1 else 's'} not committed"] if changes else []),
            *([f"{unpushed} commit{'' if unpushed == 1 else 's'} not pushed"] if unpushed else []),
        ]
        print(f"    {'folder':<10} {'; '.join([folder, *work])}")
    return 1 if fetch_failed else 0


def named_path(dependency: str, libs: str) -> str:
    """The path of a dependency, or of a submodule inside one, named by its path in the first libs folder,
    where `add` places every dependency. A leading libs folder is accepted too: `dep` and `lib/dep` agree."""
    return f"{libs}/{dependency.strip('/').removeprefix(f'{libs}/')}"


def locate(repo_root: Path, path: str) -> tuple[Path, Declared] | None:
    """The submodule at `path`, with the folder whose .gitmodules lists it: this repository for a dependency,
    a dependency for one of its own submodules. None when no .gitmodules that is checked out lists one there."""
    return next(
        (
            (directory, level)
            for directory, level in submodule_levels(repo_root, path)
            if directory / level.path == repo_root / path
        ),
        None,
    )


def classify(submodule: Path, ref: str) -> Pin:
    """Which kind of ref `ref` is, asked of git rather than of the string's shape, because a branch and a
    tag can be named anything. A branch is what a dependency can follow; a tag or commit stays put."""
    tag = git(submodule, "rev-parse", "--verify", "--quiet", f"refs/tags/{ref}^{{commit}}")
    if tag.returncode == 0:
        return Pin("tag", ref, tag.stdout.strip())
    branch = git(submodule, "rev-parse", "--verify", "--quiet", f"refs/remotes/origin/{ref}^{{commit}}")
    if branch.returncode == 0:
        return Pin(MOVING, ref, branch.stdout.strip())
    commit = git(submodule, "rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}")
    if commit.returncode == 0:
        return Pin("rev", None, commit.stdout.strip())
    return Pin("absent", None, None)


def perform(shown: str, change: Callable[[], object]) -> None:
    """Make one change without git, printed as the shell command that makes it. A failure prints the
    system's error and raises `StepFailed`: nothing is reported as done that was not."""
    try:
        change()
    except OSError as failed:
        print(f"  failed: {shown}", flush=True)
        print(f"    {failed}", flush=True)
        raise StepFailed(shown) from failed
    print(f"  ran: {shown}", flush=True)


def delete_path(repo_root: Path, target: Path) -> None:
    """Delete a folder, or a file, printed as `rm -rf`."""
    folder = target.is_dir() and not target.is_symlink()
    perform(f"rm -rf {os.path.relpath(target, repo_root)}", lambda: shutil.rmtree(target) if folder else target.unlink())


def delete(repo_root: Path, directory: Path) -> None:
    """Delete a directory a version change stranded, with its gitdir when that lives elsewhere (git would
    reuse it if the path ever returned), printing each as it goes."""
    marker = directory / ".git"
    pointer = marker.read_text().partition("gitdir:")[2].strip() if marker.is_file() else ""
    gitdir = (directory / pointer).resolve() if pointer else None
    for target in ([gitdir] if gitdir is not None and gitdir.exists() else []) + [directory]:
        delete_path(repo_root, target)


def update(repo_root: Path, dependency: str, force: bool, libs: str, remappings: list[str]) -> int:
    """Move one dependency to a version, doing only what is not already done. Returns 0 on success."""
    named = dependency
    requested_ref = None
    if "@" in dependency:
        dependency, _, requested_ref = dependency.partition("@")
    path = named_path(dependency, libs)
    submodule = repo_root / path
    print(f"{path}:")

    located = locate(repo_root, path)
    if located is None:
        print(f"  Stopped: no .gitmodules file lists a submodule at {path}.")
        return 1
    directory, entry = located
    # A submodule of a submodule is recorded, and so versioned, by its own parent.
    if directory != repo_root:
        print(f"  Stopped: {path} is a submodule inside another submodule, not a submodule of this repository.")
        print("  The submodule that contains it decides its version.")
        return 1

    facts = read_facts(repo_root, path)
    # Ahead of the work check, which reads a blank from a gitdir git will not read and would pass.
    if facts.unreadable:
        print(f"  Stopped: git cannot read the {path} folder. git says:")
        print(f"    {facts.unreadable}")
        print("  To repair it: yarn dep sync")
        return 1
    if not facts.initialised:
        print(f"  Stopped: {path} is not checked out.")
        print("  To check it out: yarn dep sync")
        return 1
    if facts.has_own_work and not force:
        stop_for_work(
            "Stopped before changing anything.",
            [describe_at_risk(item, path) for item in facts.at_risk],
            "Updating would move the folder that holds them.",
            f"yarn dep update --force {named}",
        )
        return 1

    # .gitmodules alone says what a bare update does: a branch it names is followed, and with none the
    # dependency is pinned where it is, whatever the remote's default branch has become.
    ref = requested_ref or entry.branch
    if ref is None:
        print(f"  Stopped: {path} is pinned. .gitmodules names no branch for it to follow.")
        print(f"  To move it: yarn dep update {path}@<branch, tag or commit>")
        return 1
    if requested_ref is None:
        print(f"  Following branch {ref} (set in .gitmodules).")

    target: Pin | None = None
    try:
        # The dependency alone. git's fetch otherwise follows any nested submodule that happens to be checked
        # out (fetch.recurseSubmodules defaults to on-demand) and fails on a nested pin no remote holds, for a
        # submodule nothing here may build from. The nested paths the build reads are fetched below, by name.
        run(repo_root, submodule, "fetch", "--tags", "--quiet", "--no-recurse-submodules", "origin")
        target = classify(submodule, ref)
        if target.rev is None:
            print(f"  Stopped: '{ref}' is not a tag, branch or commit in {path}.")
            return 1

        # Following a branch means standing on it, where someone working inside the dependency leaves HEAD.
        # The work check reads HEAD, so it cannot see commits only the local branch holds; standing the
        # branch at the target would take them off it, which is decided here, before anything moves.
        stranded_on_branch: list[str] = []
        if target.kind == MOVING:
            local = f"refs/heads/{target.name}"
            if git(submodule, "rev-parse", "--verify", "--quiet", local).returncode == 0:
                lacking = git(submodule, "log", "--oneline", local, "--not", target.rev)
                if lacking.returncode != 0:
                    print(f"  Stopped: git could not compare your branch {target.name} with {ref}. git says:")
                    for line in lacking.stderr.rstrip().splitlines():
                        print(f"    {line}")
                    return 1
                stranded_on_branch = lacking.stdout.splitlines()
            if stranded_on_branch and not force:
                print(f"  Stopped: your local branch {target.name} has commits that {ref} ({target.rev[:10]}) does not:")
                for line in stranded_on_branch:
                    print(f"    {line}")
                print(f"  Moving the branch to {ref} would take them off it.")
                print("  Merge or move them first, then run this again.")
                print(f"  To continue anyway: yarn dep update --force {named}")
                print("  (HEAD then moves without the branch, and the branch keeps its commits.)")
                return 1

        attach = target.kind == MOVING and not stranded_on_branch
        on_branch = git(submodule, "symbolic-ref", "--quiet", "HEAD").stdout.strip() == f"refs/heads/{target.name}"
        if facts.worktree != target.rev or (attach and not on_branch):
            # `origin/<ref>` is what `classify` resolved a branch from, so it lands on exactly that commit.
            move: list[str] = ["--track", "-B", ref, f"origin/{ref}"] if attach else [target.rev]
            run(repo_root, submodule, "checkout", "--quiet", *move)
        if target.kind == MOVING and not attach:
            print(f"  Your branch {target.name} keeps its own commits, so HEAD is now detached at {target.rev[:10]}.")

        # A branch is recorded to be followed; a tag or a commit removes the line, pinning the dependency there.
        follows = target.name if target.kind == MOVING else None
        if entry.branch != follows:
            key = f"submodule.{entry.name}.branch"
            if follows is None:
                run(repo_root, repo_root, "config", "-f", ".gitmodules", "--unset", key)
            else:
                run(repo_root, repo_root, "config", "-f", ".gitmodules", key, follows)

        # Lazy, so each level is checked out before the walk reads the next level's .gitmodules from it.
        for directory, level in nested_levels(repo_root, path, remappings):
            if not at_record(directory, level):
                run(repo_root, directory, "submodule", "update", "--init", "--", level.path)

        for stranded in read_facts(repo_root, path).litter:
            delete(repo_root, submodule / stranded)
    except StepFailed:
        report_move(repo_root, path, ref, target, remappings)
        return 1
    return report_move(repo_root, path, ref, target, remappings)


def report_move(repo_root: Path, path: str, ref: str, target: Pin | None, remappings: list[str]) -> int:
    """Print the move's checklist as it now stands, then what is left for the user. Returns 0 when every
    stage this tool performs is done."""
    nested_off: dict[str, str] = {}
    for directory, level in nested_levels(repo_root, path, remappings):
        if not at_record(directory, level):
            located = directory.relative_to(repo_root).as_posix()
            display = (directory / level.path).relative_to(repo_root).as_posix()
            nested_off[display] = f"git -C {located} submodule update --init -- {level.path}"
    rev = target.rev if target is not None else None
    follows = target.name if target is not None and target.kind == MOVING else None
    stages = move_checklist(
        read_facts(repo_root, path), ref, rev, follows, recorded_entry(repo_root, path), list(nested_off.items())
    )
    for stage in stages:
        print(f"  [{'x' if stage.done else ' '}] {stage.number}. {stage.name} - {stage.detail}")
        if not stage.done and stage.action:
            print(f"        {stage.action}")
    report_unused_checkouts(repo_root, path, remappings)

    # Stages 2-5 are this tool's to perform; 0 stays open under --force on purpose, and 6-7 are the user's.
    outstanding = [stage for stage in stages if not stage.done and 2 <= stage.number <= 5]
    if outstanding:
        print(f"  Not finished: {len(outstanding)} of the steps above are not done.")
        return 1
    yours = [stage.action for stage in stages if not stage.done and stage.number >= 6]
    if not yours:
        print(f"  Nothing to do: {path} is already committed at {ref} ({(rev or '')[:10]}).")
        return 0
    print(f"  Next, run: {' && '.join(yours)}")
    return 0


def add(repo_root: Path, url: str, ref: str | None, libs: str, remappings: list[str]) -> int:
    """Clone a new dependency into the first libs folder and lay it out as `git submodule add` does, leaving
    the index alone. `ref` is `-b` passed through: a branch or tag, or, when not given, git's default - the
    remote's default branch, recorded nowhere. Returns 0 on success."""
    path = f"{libs}/{re.split(r'[/:]', url.rstrip('/'))[-1].removesuffix('.git')}"
    checkout = repo_root / path
    print(f"{path}:")

    # Where git keeps a submodule's repository, asked of git: it is elsewhere when this repository is itself a
    # submodule. A new submodule is named by its path, as `git submodule add` names it.
    gitdir = Path(git(repo_root, "rev-parse", "--path-format=absolute", "--git-path", f"modules/{path}").stdout.strip())
    listed = any(path in (entry.path, entry.name) for entry in declared_submodules(repo_root))
    in_use = [
        reason
        for reason, found in (
            (f"the folder {path} exists", checkout.exists()),
            (f".gitmodules lists a submodule at {path}", listed),
            (f"git tracks files in {path}", git(repo_root, "ls-files", "--", path).stdout.strip() != ""),
            (
                f"{os.path.relpath(gitdir, repo_root)} exists, where git keeps the repository of a submodule at {path}",
                gitdir.exists(),
            ),
        )
        if found
    ]
    if in_use:
        print(f"  Stopped: {path} is already in use:")
        for reason in in_use:
            print(f"    {reason}")
        print("  Remove what is there, then run this again.")
        return 1

    try:
        # The layout `git submodule add` writes, step by step, since that command also stages. The clone points
        # to its repository by an absolute path, which breaks when the project moves, so the pointer is
        # rewritten relative, as git writes it.
        relative_gitdir = os.path.relpath(gitdir, repo_root)
        # The clone creates the repository's folder but not the folders above it, which a project with no
        # submodules yet does not have.
        if not gitdir.parent.is_dir():
            perform(
                f"mkdir -p {os.path.dirname(relative_gitdir)}", lambda: gitdir.parent.mkdir(parents=True, exist_ok=True)
            )
        # --branch takes a branch or a tag, and asks the remote for it before writing anything. It stands on a
        # branch, tracking it, and detaches at a tag. Without it, git takes the remote's default branch.
        branch = ["--branch", ref] if ref is not None else []
        run(
            repo_root,
            repo_root,
            "clone",
            "--quiet",
            "--no-recurse-submodules",
            *branch,
            f"--separate-git-dir={relative_gitdir}",
            url,
            path,
        )
        pointer = os.path.relpath(gitdir, checkout)
        perform(f'echo "gitdir: {pointer}" > {path}/.git', lambda: (checkout / ".git").write_text(f"gitdir: {pointer}\n"))
        run(repo_root, checkout, "config", "core.worktree", os.path.relpath(checkout, gitdir))
        run(repo_root, repo_root, "config", "-f", ".gitmodules", f"submodule.{path}.path", path)
        run(repo_root, repo_root, "config", "-f", ".gitmodules", f"submodule.{path}.url", url)
        # The branch it stands on is recorded, whether -b named it or the remote's default branch was taken:
        # .gitmodules then says what a bare update follows. git records the default branch nowhere. A tag
        # leaves HEAD detached, so nothing is recorded and the dependency is pinned there.
        standing = git(checkout, "symbolic-ref", "--quiet", "--short", "HEAD").stdout.strip()
        if standing:
            run(repo_root, repo_root, "config", "-f", ".gitmodules", f"submodule.{path}.branch", standing)
        if ref is None and standing:
            print(f"  Following branch {standing}, the remote's default branch. .gitmodules records it.")
        run(repo_root, repo_root, "config", f"submodule.{path}.url", url)
        run(repo_root, repo_root, "config", f"submodule.{path}.active", "true")

        # Lazy, so each level is checked out before the walk reads the next level's .gitmodules from it.
        for directory, level in nested_levels(repo_root, path, remappings):
            if not at_record(directory, level):
                run(repo_root, directory, "submodule", "update", "--init", "--", level.path)
    except StepFailed:
        return 1
    print(f"  Next, run: git add --no-warn-embedded-repo .gitmodules {path} && git commit")
    return 0


def remove(repo_root: Path, dependency: str, force: bool, libs: str) -> int:
    """Delete a dependency, or take away the checkout of a submodule inside one. Returns 0 on success."""
    path = named_path(dependency, libs)
    checkout = repo_root / path
    print(f"{path}:")
    located = locate(repo_root, path)
    if located is None:
        print(f"  Stopped: no .gitmodules file lists a submodule at {path}.")
        return 1
    directory, entry = located
    parent = directory.relative_to(repo_root).as_posix()

    # git removes only a submodule it tracks. One that `add` cloned and that is not yet staged is not one.
    if staged_gitlink(directory, entry.path) is None:
        in_parent = "git" if directory == repo_root else f"git -C {parent}"
        print(f"  Stopped: git does not track {path} yet, so git cannot remove it.")
        print(f"  Stage it first, then run this again: {in_parent} add --no-warn-embedded-repo .gitmodules {entry.path}")
        return 1

    if (checkout / ".git").exists() and not force:
        # Ahead of the work check, which reads a blank from a gitdir git will not read and would pass.
        head = git(checkout, "rev-parse", "HEAD")
        if head.returncode != 0:
            print(f"  Stopped: git cannot read the {path} folder. git says:")
            for line in head.stderr.strip().splitlines():
                print(f"    {line}")
            print("  So it is not known whether the folder holds work that exists only on this computer.")
            print(f"  To continue anyway: yarn dep remove --force {dependency}")
            return 1
        held = [describe_at_risk(item, path) for item in at_risk(checkout)]
        if held:
            stop_for_work(
                "Stopped before changing anything.",
                held,
                "Removing deletes the folder that holds them.",
                f"yarn dep remove --force {dependency}",
            )
            return 1

    try:
        run(repo_root, directory, "submodule", "deinit", "--force", "--quiet", "--", entry.path)
        if directory != repo_root:
            # The dependency lists this submodule and records its commit, so only the checkout goes.
            print(f"  {parent} still lists {entry.path} in its .gitmodules, so there is nothing to add or commit.")
            return 0
        # This repository stops depending on it. git keeps a removed submodule's repository, and gitsubmodules(7)
        # says to delete it by hand to remove the submodule completely.
        gitdir = Path(
            git(repo_root, "rev-parse", "--path-format=absolute", "--git-path", f"modules/{entry.name}").stdout.strip()
        )
        if gitdir.exists():
            delete_path(repo_root, gitdir)
    except StepFailed:
        return 1
    # `git rm` takes the folder and the .gitmodules entry out, and stages both.
    print(f"  Next, run: git rm {path} && git commit")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(prog="dep", usage=USAGE)
    subcommands = parser.add_subparsers(dest="subcommand", required=True)
    subcommands.add_parser("sync")
    showing = subcommands.add_parser("status")
    showing.add_argument("--no-fetch", action="store_true")
    adding = subcommands.add_parser("add")
    adding.add_argument("-b", "--branch")
    adding.add_argument("url")
    updating = subcommands.add_parser("update")
    updating.add_argument("--force", action="store_true")
    updating.add_argument("dependencies", nargs="+")
    removing = subcommands.add_parser("remove")
    removing.add_argument("--force", action="store_true")
    removing.add_argument("dependencies", nargs="+")
    arguments = parser.parse_args()

    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True)
    if top.returncode != 0:
        print("error: not inside a git repository", file=sys.stderr)
        return 1
    repo_root = Path(top.stdout.strip())
    config = read_forge_config(repo_root)
    if config is None:
        return 1
    remappings: list[str] = config["remappings"]
    libs = PurePosixPath(config["libs"][0]).as_posix()
    if arguments.subcommand == "status":
        return status(repo_root, remappings, not arguments.no_fetch)
    if arguments.subcommand == "add":
        return add(repo_root, arguments.url, arguments.branch, libs, remappings)
    if arguments.subcommand == "update":
        return max(
            update(repo_root, dependency, arguments.force, libs, remappings) for dependency in arguments.dependencies
        )
    if arguments.subcommand == "remove":
        return max(remove(repo_root, dependency, arguments.force, libs) for dependency in arguments.dependencies)
    return sync(repo_root, remappings)


if __name__ == "__main__":
    sys.exit(main())
